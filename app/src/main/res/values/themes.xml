<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Metro" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">#0050EF</item>
        <item name="android:windowAnimationStyle">@style/MetroWindowAnim</item>
    </style>

    <style name="Theme.Metro.Lock">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="MetroWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/hold</item>
        <item name="android:activityCloseExitAnimation">@anim/page_exit</item>
    </style>
</resources>
